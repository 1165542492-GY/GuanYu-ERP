<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>SupplierErpApp</RootNamespace>
    <AssemblyName>冠誉制造ERP</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="docs/**" />
    <Compile Remove="tools/**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="App.html" LogicalName="SupplierErpApp.App.html" />
    <EmbeddedResource Include="Customer.html" LogicalName="SupplierErpApp.Customer.html" />
    <EmbeddedResource Include="Finance.html" LogicalName="SupplierErpApp.Finance.html" />
    <EmbeddedResource Include="Material.html" LogicalName="SupplierErpApp.Material.html" />
    <EmbeddedResource Include="Business.html" LogicalName="SupplierErpApp.Business.html" />
    <EmbeddedResource Include="TestData.html" LogicalName="SupplierErpApp.TestData.html" />
    <EmbeddedResource Include="Reconciliation.html" LogicalName="SupplierErpApp.Reconciliation.html" />
    <EmbeddedResource Include="OperationLog.html" LogicalName="SupplierErpApp.OperationLog.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>
</Project>
